# Firebase web config (Project settings → Your apps → Web app)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Or run entirely locally against the Firebase emulators:
# EXPO_PUBLIC_USE_EMULATORS=1
# EXPO_PUBLIC_EMULATOR_HOST=192.168.1.20   # your computer's LAN IP when testing on a phone

# Optional, web only: reCAPTCHA Enterprise site key for Firebase App Check (docs/DEPLOY.md, step 5b).
# EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
