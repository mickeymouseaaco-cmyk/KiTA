# Server function settings for the kita-4a2e1 project, used on every deploy
# (GitHub included). Not secrets. See docs/FIREBASE.md.

# Refuse pairing, unlink, reconnect and delete calls without a valid App Check token.
# Turn on only after App Check is set up for every platform (docs/DEPLOY.md, step 5b).
REQUIRE_APP_CHECK=false

# Language for optional voice-note transcripts, e.g. en-US or ms-MY.
TRANSCRIBE_LANGUAGE=en-US
