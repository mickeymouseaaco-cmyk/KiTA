rules_version = '2';

// Together: Cloud Storage rules.
// Media lives at couples/{cid}/media/{ownerUid}/{mediaId}.{ext}
// - Only the two members of an ACTIVE couple can read. An ended couple's files
//   are unreadable at once, and deleted by the 30-day purge.
// - Only the owner can upload (no overwrites) or delete.
// - Size and type limits: photos are resized on device to <=1600px, and
//   voice notes are capped at 5 minutes.

service firebase.storage {
  match /b/{bucket}/o {
    // Members of an active couple; an ended or missing couple gives an empty list.
    function activeMembers(cid) {
      let path = /databases/(default)/documents/couples/$(cid);
      let c = firestore.exists(path) ? firestore.get(path).data : {};
      return c.get('status', 'active') == 'active' ? c.get('members', []) : [];
    }
    function mediaPath(cid, fileName) {
      // "abc.jpg" and "abc_thumb.jpg" both belong to media record "abc".
      return /databases/(default)/documents/couples/$(cid)/media/$(fileName.split('\\.')[0].split('_thumb')[0]);
    }
    function visibleToPartner(cid, fileName) {
      return firestore.exists(mediaPath(cid, fileName))
        && (!('hiddenUntil' in firestore.get(mediaPath(cid, fileName)).data)
            || firestore.get(mediaPath(cid, fileName)).data.hiddenUntil <= request.time);
    }

    match /couples/{cid}/media/{ownerId}/{fileName} {
      // Single files only (no listing). The partner can fetch a file once its
      // Firestore record exists and isn't hidden (surprise media unlocks later).
      allow get: if request.auth != null
        && request.auth.uid in activeMembers(cid)
        && (request.auth.uid == ownerId || visibleToPartner(cid, fileName));
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == ownerId
        && request.auth.uid in activeMembers(cid)
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*') && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
        );

      allow update: if false;
      // The owner can delete their media while the couple is active. The partner
      // can delete view-once media (identified by its Firestore record) after opening it.
      allow delete: if request.auth != null
        && request.auth.uid in activeMembers(cid)
        && (
          request.auth.uid == ownerId
          || (firestore.exists(mediaPath(cid, fileName))
              && firestore.get(mediaPath(cid, fileName)).data.visibility == 'viewOnce')
        );
    }

    // Private files (voice check-ins, mood selfies, the media vault). Owner only, always.
    match /users/{uid}/private/{fileName} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow list: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (
          (request.resource.contentType.matches('(audio|image)/.*') && request.resource.size < 20 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
        );
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
