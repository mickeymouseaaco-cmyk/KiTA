rules_version = '2';

// Together: Firestore security rules.
//
// Principle: private data and shared data live in different places.
//   users/{uid}/**                 -> owner only. Never readable by the partner.
//   memberships/{uid}              -> one couple per person. Written only by server functions.
//   couples/{cid}                  -> created, ended and deleted only by server functions.
//   couples/{cid}/**               -> the two members of an ACTIVE couple. Nobody else, ever.
//   couples/{cid}/shared/{uid_date} -> the owner's chosen projection, limited by their own switches.
// See docs/ARCHITECTURE.md §2.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function me() {
      return request.auth.uid;
    }
    function coupleDoc(cid) {
      return get(/databases/$(database)/documents/couples/$(cid));
    }
    // THE gate for all shared data: an active couple that lists me.
    // A cid from another couple fails here, whatever the path.
    function isMember(cid) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(cid))
        && coupleDoc(cid).data.get('status', 'active') == 'active'
        && me() in coupleDoc(cid).data.members;
    }
    function hasCouple() {
      return exists(/databases/$(database)/documents/memberships/$(me()));
    }
    // My own privacy switch for one category (steps, food, cycle, mood, media).
    // Defaults match the app's DEFAULT_SHARE: steps and food on; mood, cycle and media off.
    function shareOn(key) {
      let path = /databases/$(database)/documents/users/$(me())/settings/share;
      let fallback = key in ['steps', 'food'];
      return exists(path) ? get(path).data.get(key, fallback) == true : fallback;
    }
    function incoming() {
      return request.resource.data;
    }
    function changed() {
      return incoming().diff(resource.data).affectedKeys();
    }
    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // ---------------------------------------------------------------- users
    // Profile, settings, private daily logs, vault. Owner only.
    // The couple pointer (coupleId) is written only by server functions.
    match /users/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid && incoming().get('coupleId', null) == null;
      allow update: if signedIn() && me() == uid && !('coupleId' in changed());
      allow delete: if false; // the deleteAccount function only

      // Everything under the profile (days, settings, vault…). {sub} makes this
      // need at least one more segment: a bare {document=**} would also match
      // users/{uid} itself and override the rules above.
      match /{sub}/{document=**} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // ---------------------------------------------------------- memberships
    // One document per person = one couple per person. Server functions only.
    match /memberships/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // -------------------------------------------------------------- invites
    // A 6-character code is the capability. Anyone signed in may fetch a code
    // they were given. Nobody may enumerate other people's codes.
    match /invites/{code} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.fromUid == me();

      allow create: if signedIn()
        && !hasCouple()
        && code.matches('^[A-Z2-9]{6}$')
        && incoming().keys().hasOnly(['fromUid', 'fromName', 'status', 'createdAt', 'expiresAt'])
        && incoming().fromUid == me()
        && str(incoming().fromName, 60)
        && incoming().status == 'open'
        && incoming().createdAt == request.time
        && incoming().expiresAt is timestamp
        && incoming().expiresAt <= request.time + duration.value(48, 'h');

      // The inviter may cancel their own open invite. Accepting happens only
      // in the acceptInvite server function, in one transaction.
      allow update: if signedIn()
        && resource.data.fromUid == me()
        && resource.data.status == 'open'
        && changed().hasOnly(['status'])
        && incoming().status == 'cancelled';
      allow delete: if false;
    }

    // -------------------------------------------------------------- couples
    match /couples/{cid} {
      // Members may read the couple doc even after it ends, so the app can say goodbye gently.
      allow get: if signedIn() && me() in resource.data.members;
      allow list: if false; // nobody can browse couples

      // Created (acceptInvite), ended (unlinkCouple) and deleted (the 30-day purge)
      // only by server functions. Members never change.
      allow create, delete: if false;

      // Each person may only change their own display name and love languages.
      allow update: if isMember(cid)
        && (
          (
            changed().hasOnly(['names'])
            && incoming().names.diff(resource.data.names).affectedKeys().hasOnly([me()])
            && str(incoming().names[me()], 60)
          ) || (
            changed().hasOnly(['loveLanguages'])
            && incoming().loveLanguages is map
            && incoming().loveLanguages.diff(resource.data.get('loveLanguages', {})).affectedKeys().hasOnly([me()])
            && incoming().loveLanguages[me()] is list
            && incoming().loveLanguages[me()].size() <= 5
          ) || (
            // My profile picture id (or removing it). Only my own entry.
            changed().hasOnly(['avatars'])
            && incoming().avatars.diff(resource.data.get('avatars', {})).affectedKeys().hasOnly([me()])
            && (!(me() in incoming().avatars) || (incoming().avatars[me()] is string && incoming().avatars[me()].size() <= 40))
          )
        );

      // ---- shared daily projections
      match /shared/{docId} {
        allow read: if isMember(cid);
        allow create, update: if isMember(cid)
          && incoming().ownerId == me()
          && docId == me() + '_' + incoming().date
          && incoming().keys().hasOnly(['ownerId', 'date', 'steps', 'stepGoal', 'mood', 'food', 'cycle', 'updatedAt'])
          && (!('mood' in incoming()) || incoming().mood.keys().hasOnly(['emoji', 'label', 'stress', 'note', 'mediaId']))
          && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          // Only what my own privacy switches allow, whatever the app sends.
          && (!('steps' in incoming()) || shareOn('steps'))
          && (!('stepGoal' in incoming()) || shareOn('steps'))
          && (!('food' in incoming()) || shareOn('food'))
          && (!('cycle' in incoming()) || shareOn('cycle'))
          && (!('mood' in incoming()) || shareOn('mood'))
          && (!('mood' in incoming()) || !('mediaId' in incoming().mood) || shareOn('media'));
        allow delete: if isMember(cid) && resource.data.ownerId == me();
      }

      // ---- love notes, hugs, quick messages
      match /messages/{messageId} {
        allow read: if isMember(cid);

        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['fromUid', 'toUid', 'kind', 'text', 'mediaId', 'voiceHug', 'viewOnce', 'expiresAt', 'favoriteBy',
               'important', 'importantBy', 'createdAt'])
          && incoming().fromUid == me()
          && (!('important' in incoming()) || (incoming().important is bool && incoming().importantBy == me()))
          && incoming().toUid != me()
          && incoming().toUid in coupleDoc(cid).data.members
          && incoming().kind in ['text', 'photo', 'voice', 'video', 'hug', 'quick']
          && incoming().favoriteBy == []
          && incoming().createdAt == request.time
          && (!('text' in incoming()) || str(incoming().text, 2000))
          && (!('viewOnce' in incoming()) || incoming().viewOnce == true)
          // Disappearing notes fade within a day.
          && (!('expiresAt' in incoming())
              || (incoming().expiresAt is timestamp && incoming().expiresAt <= request.time + duration.value(25, 'h')))
          && (!('mediaId' in incoming())
              || getAfter(/databases/$(database)/documents/couples/$(cid)/media/$(incoming().mediaId)).data.ownerId == me());

        // Hearts: each person may add or remove only themselves.
        // Read receipts and view-once opening: only the recipient.
        allow update: if isMember(cid) && (
          (
            changed().hasOnly(['favoriteBy'])
            && incoming().favoriteBy is list
            && incoming().favoriteBy.toSet().difference(resource.data.favoriteBy.toSet()).hasOnly([me()])
            && resource.data.favoriteBy.toSet().difference(incoming().favoriteBy.toSet()).hasOnly([me()])
          ) || (
            // Star as important: either person, pinned for both.
            changed().hasOnly(['important', 'importantBy'])
            && incoming().important is bool
            && incoming().importantBy == me()
          ) || (
            changed().hasOnly(['readAt'])
            && resource.data.toUid == me()
            && incoming().readAt == request.time
          ) || (
            changed().hasOnly(['viewedAt'])
            && resource.data.toUid == me()
            && resource.data.get('viewOnce', false) == true
            && !('viewedAt' in resource.data)
            && incoming().viewedAt == request.time
          )
        );

        // The sender can take a note back at any time.
        allow delete: if isMember(cid) && resource.data.fromUid == me();
      }

      // ---- Gratitude Wall: one thank-you per person per day (the doc id enforces it)
      match /gratitude/{gid} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && gid == me() + '_' + incoming().date
          && incoming().keys().hasOnly(['ownerId', 'toUid', 'date', 'text', 'mediaId', 'createdAt'])
          && incoming().ownerId == me()
          && incoming().toUid != me()
          && incoming().toUid in coupleDoc(cid).data.members
          && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && incoming().createdAt == request.time
          && (!('text' in incoming()) || str(incoming().text, 500))
          && ('text' in incoming() || 'mediaId' in incoming());
        allow update: if isMember(cid)
          && resource.data.ownerId == me()
          && changed().hasOnly(['text']);
        allow delete: if isMember(cid) && resource.data.ownerId == me();
      }

      // ---- Memory Jar
      match /memories/{memoryId} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['ownerId', 'caption', 'date', 'location', 'mediaIds', 'createdAt'])
          && incoming().ownerId == me()
          && str(incoming().caption, 500)
          && incoming().mediaIds is list
          && incoming().mediaIds.size() <= 10
          && incoming().createdAt == request.time;
        allow update: if isMember(cid)
          && resource.data.ownerId == me()
          && changed().hasOnly(['caption', 'date', 'location', 'mediaIds'])
          && str(incoming().caption, 500);
        allow delete: if isMember(cid) && resource.data.ownerId == me();
      }

      // ---- media metadata (files live in Cloud Storage)
      match /media/{mediaId} {
        // Surprise media stays hidden from the partner until it unlocks.
        allow read: if isMember(cid)
          && (resource.data.ownerId == me()
              || !('hiddenUntil' in resource.data)
              || resource.data.hiddenUntil <= request.time);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly([
               'ownerId', 'type', 'storagePath', 'contentType', 'width', 'height', 'thumbPath',
               'durationMs', 'bytes', 'visibility', 'expiresAt', 'hiddenUntil', 'allowSave', 'parent', 'createdAt'])
          && incoming().ownerId == me()
          && incoming().type in ['photo', 'voice', 'video']
          && incoming().storagePath.matches('^couples/' + cid + '/media/' + me() + '/' + mediaId + '\\.[a-z0-9]+$')
          && incoming().visibility in ['couple', 'viewOnce']
          && incoming().allowSave is bool
          && (incoming().visibility == 'couple' || incoming().allowSave == false)
          && (!('thumbPath' in incoming())
              || incoming().thumbPath == 'couples/' + cid + '/media/' + me() + '/' + mediaId + '_thumb.jpg')
          && (!('hiddenUntil' in incoming()) || incoming().hiddenUntil is timestamp)
          && incoming().createdAt == request.time;
        allow update: if isMember(cid)
          && resource.data.ownerId == me()
          && changed().hasOnly(['allowSave', 'parent']);
        // Owner can delete their media at any time, which removes it from both views.
        // View-once media is also deleted by the recipient right after opening it.
        allow delete: if isMember(cid)
          && (resource.data.ownerId == me() || resource.data.visibility == 'viewOnce');
      }

      // ---- Argument Reset: either partner starts one; each shares one appreciation.
      // You can read your partner's appreciation only after writing your own.
      match /resets/{date} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['startedBy', 'date', 'createdAt'])
          && incoming().startedBy == me()
          && incoming().date == date
          && incoming().createdAt == request.time;
        allow delete: if isMember(cid) && resource.data.startedBy == me();

        match /notes/{uid} {
          allow read: if isMember(cid)
            && (uid == me() || exists(/databases/$(database)/documents/couples/$(cid)/resets/$(date)/notes/$(me())));
          allow create, update: if isMember(cid)
            && uid == me()
            && incoming().keys().hasOnly(['text', 'createdAt'])
            && str(incoming().text, 500)
            && incoming().createdAt == request.time;
          allow delete: if isMember(cid) && uid == me();
        }
      }

      // ---- Trips: planned together, so both can edit the shared plan.
      match /trips/{tripId} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().createdBy == me()
          && str(incoming().title, 120)
          && incoming().keys().hasOnly(['title', 'destination', 'lat', 'lon', 'startDate', 'endDate', 'checklist',
               'packing', 'weather', 'stress', 'restDays', 'createdBy', 'createdAt', 'updatedAt']);
        allow update: if isMember(cid)
          && changed().hasOnly(['title', 'destination', 'lat', 'lon', 'startDate', 'endDate', 'checklist',
               'packing', 'weather', 'stress', 'restDays', 'updatedAt'])
          && (!('stress' in changed()) || incoming().stress.diff(resource.data.get('stress', {})).affectedKeys().hasOnly([me()]));
        allow delete: if isMember(cid) && resource.data.createdBy == me();

        // Shared checklist and packing list: one doc per item, so both can tick at once.
        match /items/{itemId} {
          allow read: if isMember(cid);
          allow create: if isMember(cid)
            && incoming().keys().hasOnly(['text', 'category', 'done', 'doneBy', 'suggested', 'addedBy', 'createdAt'])
            && incoming().addedBy == me()
            && str(incoming().text, 200)
            && incoming().category in ['documents', 'bookings', 'packing', 'other']
            && incoming().done is bool;
          allow update: if isMember(cid) && changed().hasOnly(['done', 'doneBy', 'text']);
          allow delete: if isMember(cid);
        }

        // Travel journal entries: photos, videos, voice diary, notes.
        match /entries/{entryId} {
          allow read: if isMember(cid);
          allow create: if isMember(cid)
            && incoming().ownerId == me()
            && incoming().keys().hasOnly(['ownerId', 'type', 'mediaId', 'caption', 'mood', 'date', 'createdAt'])
            && incoming().type in ['photo', 'video', 'voice', 'note']
            && (!('caption' in incoming()) || str(incoming().caption, 1000))
            && incoming().createdAt == request.time;
          allow update: if isMember(cid) && resource.data.ownerId == me() && changed().hasOnly(['caption', 'mood']);
          allow delete: if isMember(cid) && resource.data.ownerId == me();
        }
      }

      // ---- Shared bucket list map
      match /bucket/{pinId} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().addedBy == me()
          && incoming().keys().hasOnly(['name', 'country', 'lat', 'lon', 'note', 'visited', 'addedBy', 'createdAt'])
          && str(incoming().name, 120);
        allow update: if isMember(cid) && changed().hasOnly(['visited', 'note']);
        allow delete: if isMember(cid) && resource.data.addedBy == me();
      }

      // ---- Milestones (anniversary, birthdays, first trip...)
      match /milestones/{milestoneId} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().createdBy == me()
          && incoming().keys().hasOnly(['title', 'kind', 'date', 'yearly', 'personUid', 'createdBy', 'createdAt'])
          && str(incoming().title, 120)
          && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow update: if isMember(cid) && changed().hasOnly(['title', 'kind', 'date', 'yearly', 'personUid']);
        allow delete: if isMember(cid) && resource.data.createdBy == me();
      }

      // ---- Scheduled sends and surprise notes: invisible to the recipient until deliverAt.
      match /scheduled/{noteId} {
        allow read: if isMember(cid)
          && (resource.data.fromUid == me()
              || (resource.data.toUid == me() && resource.data.deliverAt <= request.time));
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['fromUid', 'toUid', 'kind', 'text', 'mediaId', 'surprise', 'deliverAt',
               'favoriteBy', 'createdAt'])
          && incoming().fromUid == me()
          && incoming().toUid != me()
          && incoming().toUid in coupleDoc(cid).data.members
          && incoming().kind in ['text', 'photo', 'voice', 'video']
          && incoming().surprise in ['none', 'date', 'open']
          && incoming().deliverAt is timestamp
          && incoming().deliverAt <= request.time + duration.value(400, 'd')
          && incoming().favoriteBy == []
          && incoming().createdAt == request.time
          && (!('text' in incoming()) || str(incoming().text, 2000))
          && (!('mediaId' in incoming())
              || getAfter(/databases/$(database)/documents/couples/$(cid)/media/$(incoming().mediaId)).data.ownerId == me());
        // Recipient (once delivered): hearts and "opened".
        allow update: if isMember(cid)
          && resource.data.toUid == me()
          && resource.data.deliverAt <= request.time
          && (
            (changed().hasOnly(['favoriteBy'])
              && incoming().favoriteBy.toSet().difference(resource.data.favoriteBy.toSet()).hasOnly([me()])
              && resource.data.favoriteBy.toSet().difference(incoming().favoriteBy.toSet()).hasOnly([me()]))
            || (changed().hasOnly(['openedAt']) && incoming().openedAt == request.time)
          );
        allow delete: if isMember(cid) && resource.data.fromUid == me();
      }

      // ---- Shared to-dos: one doc per item. Both add, tick, star and remove.
      match /todos/{todoId} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['text', 'forUid', 'dueDate', 'important', 'done', 'addedBy', 'fromMessageId', 'createdAt'])
          && incoming().addedBy == me()
          && str(incoming().text, 300)
          && incoming().text.size() > 0
          && (incoming().forUid == 'both' || incoming().forUid in coupleDoc(cid).data.members)
          && (incoming().dueDate == null || (incoming().dueDate is string && incoming().dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && incoming().important is bool
          && incoming().done == false
          && (!('fromMessageId' in incoming()) || incoming().fromMessageId is string)
          && incoming().createdAt == request.time;
        allow update: if isMember(cid)
          && changed().hasOnly(['text', 'forUid', 'dueDate', 'important', 'done', 'doneBy', 'doneAt'])
          && str(incoming().text, 300)
          && incoming().text.size() > 0
          && (incoming().forUid == 'both' || incoming().forUid in coupleDoc(cid).data.members)
          && (incoming().dueDate == null || (incoming().dueDate is string && incoming().dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && incoming().important is bool
          && incoming().done is bool
          && (!('doneBy' in changed()) || incoming().doneBy == me())
          && (!('doneAt' in changed()) || incoming().doneAt == request.time);
        allow delete: if isMember(cid);
      }

      // ---- Weekend planner: small plans in morning / afternoon / evening slots.
      match /plans/{planId} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['date', 'slot', 'text', 'addedBy', 'todoId', 'createdAt'])
          && incoming().addedBy == me()
          && incoming().date is string
          && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && incoming().slot in ['morning', 'afternoon', 'evening']
          && str(incoming().text, 200)
          && incoming().text.size() > 0
          && (!('todoId' in incoming()) || incoming().todoId is string)
          && incoming().createdAt == request.time;
        allow update: if isMember(cid)
          && changed().hasOnly(['date', 'slot', 'text'])
          && incoming().date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && incoming().slot in ['morning', 'afternoon', 'evening']
          && str(incoming().text, 200)
          && incoming().text.size() > 0;
        allow delete: if isMember(cid);
      }

      // ---- The shared plant: grows a little whenever either of you cares.
      match /garden/plant {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['points', 'updatedAt', 'lastCareBy'])
          && incoming().points is int && incoming().points >= 0 && incoming().points <= 3
          && incoming().lastCareBy == me();
        allow update: if isMember(cid)
          && changed().hasOnly(['points', 'updatedAt', 'lastCareBy'])
          && incoming().points is int
          && incoming().points > resource.data.points
          && incoming().points <= resource.data.points + 3
          && incoming().lastCareBy == me();
      }
      // Care days (for couple streaks): each person can only add themselves.
      match /care/{date} {
        allow read: if isMember(cid);
        allow create: if isMember(cid)
          && incoming().keys().hasOnly(['who'])
          && incoming().who == [me()];
        allow update: if isMember(cid)
          && changed().hasOnly(['who'])
          && incoming().who.toSet().difference(resource.data.who.toSet()) == [me()].toSet()
          && resource.data.who.toSet().difference(incoming().who.toSet()).size() == 0;
      }
    }
  }
}
